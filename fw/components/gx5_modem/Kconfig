menu "GX5s modem and MQTT"

    menu "Bootstrap (provisioning) broker"
        comment "Anonymous, client id = MAC. Used until the backend provisions the real broker"
        config GX5_MQTT_HOST
            string "Bootstrap broker host (name or IP)"
            default "mqtt.reactiot.com.au"
        config GX5_MQTT_PORT
            int "Broker port"
            default 1883
        config GX5_MQTT_TLS
            bool "Bootstrap broker uses TLS (handled by the modem)"
            default n
            help
                Off (port 1883), the provisioning message travels unencrypted,
                including the production broker's username and password.
    endmenu

    config GX5_MQTT_KEEPALIVE_S
        int "Keepalive (s)"
        default 120
    config GX5_MQTT_TLS_SECLEVEL
        int "TLS seclevel, all brokers: 0 none (INSECURE), 1 verify server, 2 mutual"
        range 0 2
        default 1
    config GX5_MQTT_TLS_CACERT
        string "CA cert file on the modem filesystem (upload with AT+QFUPL)"
        default "cacert.pem"

    config GX5_OTA_URL
        string "Firmware server for OTA: <url>/fw/<hardware id>-<version>.bin"
        default "http://ota.reactiot.com.au"
        help
            Fetched by the modem on {"cmd":"ota","version":"x"}. Over plain http
            the image is not authenticated: whoever can answer for this host
            can install firmware.

    config GX5_PROVISION_AFTER_FAILS
        int "Fall back to the bootstrap broker after this many failed connects"
        default 5
        range 1 200
        help
            Counts consecutive failures to reach the provisioned broker while the
            cellular network is up. After one bootstrap attempt the provisioned
            broker gets another round.

    config GX5_APN
        string "Cellular APN (empty = keep the modem's stored APN)"
        default ""

    config GX5_GNSS
        bool "Read the modem's GNSS fix (lat/lon/kmh) for telemetry, live and offline"
        default y
endmenu
